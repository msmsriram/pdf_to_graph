# ---- OpenAI ----
# Your OpenAI API key. REQUIRED. Copy this file to `.env` and fill it in.
OPENAI_API_KEY=sk-your-key-here

# Model + reasoning. gpt-6-astra is the flagship vision+reasoning model
# (successor to gpt-5.6-sol; ~2.5x the token price). If the API ever rejects
# the id, this is the ONLY value you change.
OPENAI_MODEL=gpt-6-astra
REASONING_EFFORT=high          # low | medium | high | xhigh | max
IMAGE_DETAIL=original          # low | high | original | auto  (original = best for dense charts)
OPENAI_TIMEOUT_SECONDS=900     # Allow long reasoning calls to finish before retrying

# ---- Rendering ----
RENDER_DPI=180                 # PDF page -> PNG resolution. 150-200 is a good range.
MAX_PAGES=40                   # Safety cap so a giant PDF can't blow up cost.
PAGE_BATCH_SIZE=5              # Finish this window before launching the next window
LLM_CONCURRENCY=5              # Global per-process ceiling across all documents/stages
GATE_CONCURRENCY=5
EXTRACTION_CONCURRENCY=5
GATE_TIMEOUT_SECONDS=60        # Per HTTP attempt; at most two SDK retries

# ---- Server ----
STORAGE_DIR=storage           # where PDFs, page images, crops and manifests live
STORAGE_BACKEND=local         # local | supabase; Supabase uses STORAGE_DIR as a disposable cache
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=          # backend only; never a VITE_ variable
SUPABASE_BUCKET=pdf-chart-studio
SUPABASE_TABLE=chart_studio_documents
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
