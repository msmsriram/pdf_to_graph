# Frontend environment.
#
# LOCAL DEV: leave VITE_API_BASE UNSET. The app uses relative paths and Vite's
# dev proxy (vite.config.js) forwards them to the local backend on :8000.
#
# PRODUCTION (Vercel): set this to your deployed backend origin, e.g.
# VITE_API_BASE=https://pdf-to-graph.onrender.com
#
# (Do NOT add a trailing slash.)
# VITE_API_BASE=
